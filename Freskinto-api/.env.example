NODE_ENV=development
PORT=4000
URL_PREFIX=v1

# docker-compose.yml wala local PostgreSQL
DATABASE_URL="postgresql://onlinemart:onlinemart@localhost:5433/onlinemart?schema=public"

# Kam az kam 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Mock payment gateway webhook signing secret (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret

# Admin seed script (prisma/seed.ts) — sirf ek admin banta hai
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Admin
