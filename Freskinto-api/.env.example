# Production on Render: NODE_ENV=production, PORT=10000 (Render default)
NODE_ENV=development
PORT=4000
URL_PREFIX=v1

# Local PostgreSQL or Render PostgreSQL connection string
# On Render: Use the Internal Database URL (or External Database URL if outside Render)
DATABASE_URL="postgresql://onlinemart:onlinemart@localhost:5433/onlinemart?schema=public"

# At least 32 random characters (Render can auto-generate this)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins (your Render or Vercel web URL; https://*.domain wildcards allowed)
# Example: https://freskinto-web.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Mock payment gateway webhook signing secret (HMAC-SHA256, at least 16 chars)
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret

# Admin seed script (prisma/seed.ts) — used to create the initial admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Admin
